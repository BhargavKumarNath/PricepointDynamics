# Copy to .env for local development. Not required for default local
# usage -- only needed to acquire real raw data (Kaggle) or to override
# config.yaml values (e.g. for a deployed environment).

# Kaggle dataset slug for scripts/download_raw_data.py. Defaults to the
# verified dataset (declanmcalinden/time-series-uk-supermarket-data) if
# unset -- only set this if you need a different source dataset.
# KAGGLE_DATASET_SLUG=declanmcalinden/time-series-uk-supermarket-data

# Any config.yaml value can be overridden via PRICEPOINT_<SECTION>__<FIELD>
# (see src/pricepoint/config.py) -- useful in a deployed environment where
# the container image's config.yaml isn't meant to be edited per-deploy.
# Example: restrict CORS to the real deployed frontend origin.
# PRICEPOINT_API__CORS_ORIGINS=["https://your-project.vercel.app"]
