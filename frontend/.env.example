# Copy to .env.local for local development.
#
# The FastAPI service's base URL. Local dev: run the Phase 4 API with
# `uv run uvicorn api.main:app --reload` from the repo root (defaults to
# http://localhost:8000). Production: the deployed Cloud Run URL
# (project_refactor.md §25.5). Inlined at `next build` time -- see
# environment-variables.md's "Bundling environment variables" section.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL for the two larger Parquet artifacts (predictor_context,
# SHAP explorer). Local dev: defaults to the local /data-r2 stand-in
# already committed under frontend/public/data-r2/ -- no need to set
# this locally. Production: the real Cloudflare R2 bucket URL
# (project_refactor.md §25.3).
# NEXT_PUBLIC_PARQUET_BASE_URL=https://<your-bucket>.r2.dev
