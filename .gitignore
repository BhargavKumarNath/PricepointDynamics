# Data — large files served from Google Drive at runtime
data/
*.parquet
*.joblib
*.npy

# ...except the frontend's precomputed static artifacts (project_refactor.md
# §25.3): the small JSON is meant to be committed to the frontend repo, and
# the two Parquet artifacts are committed here as the local stand-in for a
# real Cloudflare R2 bucket (no R2 credentials in this environment -- see
# WebArtifactsConfig's docstring in src/pricepoint/config.py).
!frontend/public/data/
!frontend/public/data/**
!frontend/public/data-r2/
!frontend/public/data-r2/**

# Precomputed artifacts — served from Google Drive
market_dynamics_precomputed/
shap_precomputed/
models/

# Secrets (project_refactor.md §16: credentials go in a gitignored .env,
# never committed) -- frontend/.gitignore already covers frontend/.env*
# via its own Next.js-generated rules; this covers the root-level .env.
.env
.env.*
!.env.example

# IDE & Environment
.idea/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# mkdocs build output (docs/ is the source; this is the generated site)
site/

# OS files
.DS_Store
Thumbs.db
docs/deployment.md
# Temporary / scratch files
*.log

# Agent config
.agent/
.claude/
project_refactor.md
UI_refactor.md
.gitignore
